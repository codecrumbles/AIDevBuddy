@inject DialogService DialogService

<RadzenStack Gap="1rem">
    <RadzenFormField Text="Project Name" Variant="Variant.Outlined">
        <RadzenTextBox @bind-Value="Project.Name" Style="width:100%" Placeholder="e.g. My New App" />
    </RadzenFormField>
    <RadzenFormField Text="Description" Variant="Variant.Outlined">
        <RadzenTextArea @bind-Value="Project.Description" Rows="3" Style="width:100%"
                        Placeholder="Describe the project goals and scope..." />
    </RadzenFormField>
    <RadzenRow Gap="0.5rem">
        <RadzenColumn Size="6">
            <RadzenFormField Text="Status" Variant="Variant.Outlined">
                <RadzenDropDown @bind-Value="Project.Status"
                                Data="@(new[] { "Planning", "Active", "Review", "Complete", "On Hold" })"
                                Style="width:100%" />
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn Size="6">
            <RadzenFormField Text="Lead Agent (PM or Orchestrator)" Variant="Variant.Outlined">
                <RadzenDropDown @bind-Value="Project.LeadAgentId" Data="@LeadAgents"
                                TextProperty="Name" ValueProperty="Id"
                                AllowClear="true" Placeholder="Select lead agent..."
                                Style="width:100%" />
            </RadzenFormField>
        </RadzenColumn>
    </RadzenRow>

    <RadzenCard Variant="Variant.Outlined" class="rz-p-3">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="12px" class="rz-mb-2">
            <RadzenIcon Icon="autorenew" Style="font-size:1.1rem;color:var(--rz-primary)" />
            <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mb-0">AutoLoop</RadzenText>
            <RadzenCheckBox @bind-Value="Project.AutoLoop" Name="autoloop" />
            <RadzenLabel Component="autoloop" class="rz-mb-0">Enable autonomous agent loop</RadzenLabel>
        </RadzenStack>
        @if (Project.AutoLoop)
        {
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="8px" class="rz-mb-2">
                <RadzenText TextStyle="TextStyle.Caption" class="rz-mb-0 rz-color-secondary">Turn interval (seconds):</RadzenText>
                <RadzenNumeric @bind-Value="Project.AutoLoopIntervalSeconds" Min="10" Max="300" Style="width:100px" />
                <RadzenText TextStyle="TextStyle.Caption" class="rz-mb-0 rz-color-secondary">
                    — agents work every @Project.AutoLoopIntervalSeconds s
                </RadzenText>
            </RadzenStack>
            <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary">
                When started, agents will work through all BMAD phases automatically until the project is complete.
                An agent that is stuck will route to a peer agent for help.
            </RadzenText>
        }
    </RadzenCard>

    <RadzenCard Variant="Variant.Outlined" class="rz-p-3">
        <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mb-2">
            <RadzenIcon Icon="group" class="rz-mr-1" />Assign Agents
        </RadzenText>
        <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary rz-mb-2">
            Select which BMAD agents will work on this project. The lead agent and all selected agents will be notified on project creation.
        </RadzenText>
        <RadzenStack Gap="4px">
            @foreach (var agent in AllAgents)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="8px" class="rz-p-1">
                    <RadzenCheckBox @bind-Value="@_selectedAgentIds[agent.Id]" Name="@($"agent_{agent.Id}")" />
                    <RadzenLabel Component="@($"agent_{agent.Id}")">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="6px">
                            <RadzenBadge Text="@agent.Role.ToString()" BadgeStyle="BadgeStyle.Primary" />
                            <RadzenText TextStyle="TextStyle.Body2" class="rz-mb-0">@agent.Name</RadzenText>
                        </RadzenStack>
                    </RadzenLabel>
                </RadzenStack>
            }
        </RadzenStack>
        <RadzenStack Orientation="Orientation.Horizontal" Gap="8px" class="rz-mt-2">
            <RadzenButton Text="Select All" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                          Click="@(() => SelectAll(true))" />
            <RadzenButton Text="Clear All" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                          Click="@(() => SelectAll(false))" />
        </RadzenStack>
    </RadzenCard>

    <RadzenStack Orientation="Orientation.Horizontal" Gap="8px" JustifyContent="JustifyContent.End">
        <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Secondary"
                      Click="@(() => DialogService.Close(null))" />
        <RadzenButton Text="@(IsEdit ? "Save" : "Create Project")" Icon="@(IsEdit ? "save" : "add")"
                      ButtonStyle="ButtonStyle.Primary"
                      Click="@ConfirmCreate"
                      Disabled="@string.IsNullOrWhiteSpace(Project.Name)" />
    </RadzenStack>
</RadzenStack>

@code {
    [Parameter] public Project Project { get; set; } = new();
    [Parameter] public List<Agent> AllAgents { get; set; } = new();
    [Parameter] public bool IsEdit { get; set; } = false;

    // BMAD lead is typically John (PM) or Barry (Quick Flow)
    private List<Agent> LeadAgents => AllAgents
        .Where(a => a.Role is AgentRole.ProductManager or AgentRole.QuickFlowDev)
        .ToList();

    private Dictionary<int, bool> _selectedAgentIds = new();

    protected override void OnInitialized()
    {
        foreach (var agent in AllAgents)
            _selectedAgentIds[agent.Id] = false;
    }

    private void SelectAll(bool selected)
    {
        foreach (var key in _selectedAgentIds.Keys.ToList())
            _selectedAgentIds[key] = selected;
    }

    private void ConfirmCreate()
    {
        var selectedIds = _selectedAgentIds
            .Where(kv => kv.Value)
            .Select(kv => kv.Key)
            .ToList();
        DialogService.Close((Project, selectedIds));
    }
}
