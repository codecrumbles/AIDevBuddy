@page "/settings/llm"
@rendermode InteractiveServer
@inject ILlmSettingsService LlmSettingsService
@inject NotificationService NotificationService

<PageTitle>AIDevBuddy - LLM Settings</PageTitle>

<RadzenText TextStyle="TextStyle.H4" class="rz-mb-4">
    <RadzenIcon Icon="psychology" class="rz-mr-2" />LLM Connections
</RadzenText>
<RadzenText TextStyle="TextStyle.Body1" class="rz-mb-4 rz-color-secondary">
    Configure connections to Large Language Model providers. These enable your BMAD agents to process requests and generate responses.
</RadzenText>

@if (_loading)
{
    <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
}
else
{
    <RadzenStack Gap="1.5rem">
        @foreach (var setting in _settings)
        {
            <RadzenCard>
                <RadzenStack Gap="1rem">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="12px">
                        <RadzenIcon Icon="@GetProviderIcon(setting.Provider)" Style="font-size:2rem" />
                        <RadzenStack Gap="2px" Style="flex:1">
                            <RadzenText TextStyle="TextStyle.H6" class="rz-mb-0">@GetProviderName(setting.Provider)</RadzenText>
                            <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary rz-mb-0">@GetProviderDescription(setting.Provider)</RadzenText>
                        </RadzenStack>
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="8px">
                            @if (setting.IsDefault)
                            {
                                <RadzenBadge Text="Default" BadgeStyle="BadgeStyle.Success" />
                            }
                            <RadzenButton ButtonStyle="@(setting.IsEnabled ? ButtonStyle.Success : ButtonStyle.Secondary)"
                                          Text="@(setting.IsEnabled ? "Enabled" : "Disabled")"
                                          Click="@(async () => { setting.IsEnabled = !setting.IsEnabled; await SaveSetting(setting); })" />
                        </RadzenStack>
                    </RadzenStack>

                    @if (setting.Provider != LlmProvider.LocalLlm)
                    {
                        <RadzenRow Gap="0.5rem">
                            <RadzenColumn Size="6">
                                <RadzenFormField Text="API Key" Variant="Variant.Outlined" Style="width:100%">
                                    <RadzenTextBox @bind-Value="setting.ApiKey" Style="width:100%"
                                                    Placeholder="Enter API key..." />
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="6">
                                <RadzenFormField Text="Model Name" Variant="Variant.Outlined" Style="width:100%">
                                    <RadzenTextBox @bind-Value="setting.ModelName" Style="width:100%" />
                                </RadzenFormField>
                            </RadzenColumn>
                        </RadzenRow>
                        @if (setting.Provider != LlmProvider.Copilot)
                        {
                            <RadzenFormField Text="API Endpoint" Variant="Variant.Outlined" Style="width:100%">
                                <RadzenTextBox @bind-Value="setting.Endpoint" Style="width:100%" />
                            </RadzenFormField>
                        }
                    }
                    else
                    {
                        <RadzenAlert AlertStyle="AlertStyle.Info">
                            Local LLM uses Ollama. Ensure Ollama is running at the configured endpoint.
                            Models can be downloaded via the Ollama CLI: ollama pull llama3
                        </RadzenAlert>
                        <RadzenRow Gap="0.5rem">
                            <RadzenColumn Size="6">
                                <RadzenFormField Text="Ollama Endpoint" Variant="Variant.Outlined" Style="width:100%">
                                    <RadzenTextBox @bind-Value="setting.Endpoint" Style="width:100%" />
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="6">
                                <RadzenFormField Text="Model Name" Variant="Variant.Outlined" Style="width:100%">
                                    <RadzenTextBox @bind-Value="setting.ModelName" Style="width:100%"
                                                   Placeholder="e.g. llama3, mistral, phi3..." />
                                </RadzenFormField>
                            </RadzenColumn>
                        </RadzenRow>
                        <RadzenFormField Text="Local Model Path (optional)" Variant="Variant.Outlined" Style="width:100%">
                            <RadzenTextBox @bind-Value="setting.LocalModelPath" Style="width:100%"
                                           Placeholder="Path to local GGUF model file..." />
                        </RadzenFormField>
                    }

                    <RadzenStack Orientation="Orientation.Horizontal" Gap="8px" JustifyContent="JustifyContent.End">
                        @if (!setting.IsDefault && setting.IsEnabled)
                        {
                            <RadzenButton Text="Set as Default" Icon="star" ButtonStyle="ButtonStyle.Light"
                                          Click="@(async () => await SetDefault(setting.Provider))" />
                        }
                        <RadzenButton Text="Save" Icon="save" ButtonStyle="ButtonStyle.Primary"
                                      Click="@(async () => await SaveSetting(setting))" />
                    </RadzenStack>
                </RadzenStack>
            </RadzenCard>
        }
    </RadzenStack>
}

@code {
    private bool _loading = true;
    private List<LlmSetting> _settings = new();

    protected override async Task OnInitializedAsync()
    {
        _settings = await LlmSettingsService.GetAllSettingsAsync();
        _loading = false;
    }

    private async Task SaveSetting(LlmSetting setting)
    {
        await LlmSettingsService.UpdateSettingAsync(setting);
        NotificationService.Notify(NotificationSeverity.Success, "Settings Saved", $"{GetProviderName(setting.Provider)} settings updated.");
    }

    private async Task SetDefault(LlmProvider provider)
    {
        await LlmSettingsService.SetDefaultProviderAsync(provider);
        _settings = await LlmSettingsService.GetAllSettingsAsync();
        NotificationService.Notify(NotificationSeverity.Success, "Default Provider Set", $"{GetProviderName(provider)} is now the default LLM.");
    }

    private string GetProviderName(LlmProvider p) => p switch
    {
        LlmProvider.Copilot => "GitHub Copilot",
        LlmProvider.GLM => "GLM (Zhipu AI)",
        LlmProvider.Claude => "Anthropic Claude",
        LlmProvider.LocalLlm => "Local LLM (Ollama)",
        _ => p.ToString()
    };

    private string GetProviderIcon(LlmProvider p) => p switch
    {
        LlmProvider.Copilot => "code",
        LlmProvider.GLM => "translate",
        LlmProvider.Claude => "auto_awesome",
        LlmProvider.LocalLlm => "computer",
        _ => "psychology"
    };

    private string GetProviderDescription(LlmProvider p) => p switch
    {
        LlmProvider.Copilot => "GitHub Copilot API - GPT-4o powered development assistant",
        LlmProvider.GLM => "Zhipu AI GLM-4 - Powerful bilingual large language model",
        LlmProvider.Claude => "Anthropic Claude 3.5 Sonnet - Advanced AI assistant",
        LlmProvider.LocalLlm => "Ollama local inference - Run LLMs on your own hardware",
        _ => ""
    };
}
